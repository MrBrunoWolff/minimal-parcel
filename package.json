{
  "name": "minimal-parcel",
  "version": "0.0.1",
  "private": true,
  "description": "A minimal starting structure using Parcel and TypeScript",
  "bugs": {
    "url": "https://github.com/MrBrunoWolff/minimal-parcel/issues"
  },
  "license": "MIT",
  "author": "Bruno Wolff",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrBrunoWolff/minimal-parcel.git"
  },
  "source": "index.html",
  "scripts": {
    "start": "parcel",
    "build": "tsc && parcel build",
    "audit": "bun audit --audit-level=high",
    "check:ci": "node scripts/quality.mjs",
    "check:code": "node scripts/quality.mjs code",
    "check:security": "node scripts/quality.mjs security"
  },
  "devDependencies": {
    "parcel": "latest",
    "typescript": "latest"
  },
  "packageManager": "bun@1.4.2"
}
